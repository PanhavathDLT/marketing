# Neon DB connection string — copy from your Neon dashboard (Project → Connection Details)
DATABASE_URL="postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require"
PORT=4000
NODE_ENV=development

JWT_SECRET=change_this_to_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change_this_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Seed (pnpm db:seed). Defaults to admin@example.com / Admin12345! outside production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345!

# ─── External Server Clients ──────────────────────────────────────────────────
# Seeded by pnpm db:seed. Share LOS_CLIENT_SECRET with the LOS backend team.
# Generate a strong secret: openssl rand -hex 32
LOS_CLIENT_ID=los-backend
LOS_CLIENT_SECRET=change_this_to_a_secure_random_secret

# ─── Storage ──────────────────────────────────────────────────────────────────
# 'db'         → files stored as binary in Neon DB, served at APP_URL/files/<id>  (default for Railway)
# 'local'      → files saved to public/uploads/, served at APP_URL/uploads/<filename>
# 'cloudinary' → files uploaded to Cloudinary (set CLOUDINARY_* vars below)
# 's3'         → files uploaded to the public 'uploads' bucket in Neon Object Storage (set AWS_* vars below)
STORAGE_DRIVER=db
APP_URL=http://localhost:4000

# Required only when STORAGE_DRIVER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Required only when STORAGE_DRIVER=s3 — copy all four from Neon (Object storage → Connect)
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
