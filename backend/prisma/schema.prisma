generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  CUSTOMER
  ADMIN
}


enum MissionType {
  REFERRAL
  APPLICATION_SUBMISSION
  LOAN_APPROVAL
  REPAYMENT
  COMPLETE_FORM1
  COMPLETE_FORM2
  COMPLETE_FORM3
  COMPLETE_FORM4
}

enum MissionStatus {
  IN_PROGRESS
  CLAIMABLE
  CLAIMED
}

enum PointsSource {
  MISSION
  CHECK_IN
  REDEEM
  REFERRAL
  EXPIRE
}

enum RedemptionStatus {
  PENDING_PICKUP
  COLLECTED
  EXPIRED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id               Int               @id @default(autoincrement())
  role             Role              @default(CUSTOMER)
  customerProfile  CustomerProfile?
  staffProfile     StaffProfile?
  refreshTokens    RefreshToken[]
  pointsHistory    PointsHistory[]
  checkIns         CheckIn[]
  customerMissions CustomerMission[]
  redemptions      Redemption[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CustomerProfile {
  id               Int               @id @default(autoincrement())
  userId           Int               @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  losUserId        Int?              @unique
  name             String?
  phone            String?           @unique
  points           Int               @default(0)
  tier             String            @default("BRONZE")
  lastCheckInDate  DateTime?         @db.Date
  currentStreakDay Int               @default(0)
  referralCode     String            @unique
  referredById     Int?              // CustomerProfile.id of the referrer
  referredBy       CustomerProfile?  @relation("Referrals", fields: [referredById], references: [id])
  referrals        CustomerProfile[] @relation("Referrals")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model StaffProfile {
  id          Int        @id @default(autoincrement())
  userId      Int        @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  email       String     @unique
  password    String
  name        String?
  staffRoleId Int?
  staffRole   StaffRole? @relation(fields: [staffRoleId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// ─── RBAC ─────────────────────────────────────────────────────────────────────

model StaffRole {
  id          Int                   @id @default(autoincrement())
  name        String                @unique
  description String?
  permissions StaffRolePermission[]
  users       StaffProfile[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model Permission {
  id      Int                   @id @default(autoincrement())
  module  String
  action  String
  roles   StaffRolePermission[]

  @@unique([module, action])
}

model StaffRolePermission {
  id           Int        @id @default(autoincrement())
  staffRoleId  Int
  permissionId Int
  staffRole    StaffRole  @relation(fields: [staffRoleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([staffRoleId, permissionId])
}

model Campaign {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  missions    Mission[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Mission {
  id               Int               @id @default(autoincrement())
  campaignId       Int
  campaign         Campaign          @relation(fields: [campaignId], references: [id])
  type             MissionType
  title            String
  points           Int
  requiredCount    Int               @default(1)
  startDate        DateTime
  endDate          DateTime
  iconUrl          String?
  customerMissions CustomerMission[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model CustomerMission {
  id         Int           @id @default(autoincrement())
  customerId Int
  customer   User          @relation(fields: [customerId], references: [id])
  missionId  Int
  mission    Mission       @relation(fields: [missionId], references: [id])
  status     MissionStatus @default(IN_PROGRESS)
  progress   Int           @default(0)
  claimedAt  DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([customerId, missionId])
}

model CheckIn {
  id           Int      @id @default(autoincrement())
  customerId   Int
  customer     User     @relation(fields: [customerId], references: [id])
  checkInDate  DateTime @db.Date
  day          Int
  points       Int
  createdAt    DateTime @default(now())

  @@unique([customerId, checkInDate])
}

model PointsHistory {
  id          Int          @id @default(autoincrement())
  customerId  Int
  customer    User         @relation(fields: [customerId], references: [id])
  source      PointsSource
  missionType MissionType?
  title       String
  points      Int          // signed: positive = earned, negative = spent
  createdAt   DateTime     @default(now())
}

model RewardItem {
  id          Int          @id @default(autoincrement())
  title       String
  points      Int
  imageUrl    String?
  stock       Int          @default(0)
  isActive    Boolean      @default(true)
  redemptions Redemption[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model MachineClient {
  id           Int      @id @default(autoincrement())
  clientId     String   @unique
  clientSecret String             // bcrypt hashed
  name         String             // human-readable label e.g. "LOS Backend"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TierConfig {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  minPoints Int      @default(0)
  iconUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Redemption {
  id              Int              @id @default(autoincrement())
  customerId      Int
  customer        User             @relation(fields: [customerId], references: [id])
  rewardItemId    Int
  rewardItem      RewardItem       @relation(fields: [rewardItemId], references: [id])
  points          Int              // cost at time of redemption
  status          RedemptionStatus @default(PENDING_PICKUP)
  idempotencyKey  String?          @unique
  redeemedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model StoredFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}

model ReferralConfig {
  id           Int      @id @default(autoincrement())
  refereeBonus Int      @default(0)   // points auto-awarded to the referee on code apply
  updatedAt    DateTime @updatedAt
}
