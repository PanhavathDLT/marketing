{
  "info": {
    "name": "Marketing Backend — LOS Integration",
    "description": "Server-to-server endpoints called by the LOS backend.\n\nAuthentication: set X-Client-Id and X-Client-Secret in the collection variables before use.\n\nBase URL: http://localhost:3000/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "los-backend",
      "type": "string"
    },
    {
      "key": "clientSecret",
      "value": "REPLACE_WITH_LOS_CLIENT_SECRET",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Trigger Mission Progress",
      "item": [
        {
          "name": "REFERRAL — Referred friend applied",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"REFERRAL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire when a referred friend successfully applies for a loan. Increments the *referrer's* REFERRAL mission progress."
          }
        },
        {
          "name": "APPLICATION_SUBMISSION — Customer submitted application",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"APPLICATION_SUBMISSION\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire when a customer submits a loan application."
          }
        },
        {
          "name": "LOAN_APPROVAL — Loan was approved",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"LOAN_APPROVAL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire when a customer's loan application is approved."
          }
        },
        {
          "name": "REPAYMENT — Customer made a repayment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"REPAYMENT\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire each time a customer makes an on-time repayment. If the mission requiredCount is 3, this endpoint must be called 3 times before the mission becomes CLAIMABLE."
          }
        },
        {
          "name": "COMPLETE_FORM1 — Customer completed Form 1",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"COMPLETE_FORM1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire when a customer completes Form 1."
          }
        },
        {
          "name": "COMPLETE_FORM2 — Customer completed Form 2",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"COMPLETE_FORM2\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire when a customer completes Form 2."
          }
        },
        {
          "name": "COMPLETE_FORM3 — Customer completed Form 3",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"COMPLETE_FORM3\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire when a customer completes Form 3."
          }
        },
        {
          "name": "COMPLETE_FORM4 — Customer completed Form 4",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",   "value": "application/json" },
              { "key": "X-Client-Id",     "value": "{{clientId}}" },
              { "key": "X-Client-Secret", "value": "{{clientSecret}}" }
            ],
            "url": { "raw": "{{baseUrl}}/los/missions/complete", "host": ["{{baseUrl}}"], "path": ["los", "missions", "complete"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"losUserId\": 123,\n  \"missionType\": \"COMPLETE_FORM4\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Fire when a customer completes Form 4."
          }
        }
      ]
    }
  ]
}
